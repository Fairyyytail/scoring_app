{% extends 'base.html.twig' %}
{% block body %}
    <h1>Регистрация клиента</h1>
    {{ form_start(form) }}
    {{ form_row(form.firstName) }}
    {{ form_row(form.lastName) }}
    {{ form_row(form.phone) }}
    {{ form_row(form.email) }}
    {{ form_row(form.education) }}
    {{ form_row(form.personalDataConsent) }}
    <button type="submit">Зарегистрировать</button>
    {{ form_end(form) }}
{% endblock %}
